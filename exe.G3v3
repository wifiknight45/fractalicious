import numpy as np
import matplotlib.pyplot as plt

# Define parameters
width, height = 1500, 1500  # Moderate resolution
max_iter = 250  # Moderate number of iterations
threshold = 2.0  # Escape threshold

# Zoom into a moderately detailed region
x_min, x_max = -1.0, -0.5
y_min, y_max = 0.0, 0.5
x = np.linspace(x_min, x_max, width)
y = np.linspace(y_min, y_max, height)
c = x[:, None] + 1j * y[None, :]

# Initialize arrays
z = np.zeros((width, height), dtype=complex)
escape_time = np.full((width, height), max_iter, dtype=int)
not_escaped = np.full((width, height), True, dtype=bool)

# Iterate to compute the Mandelbrot set
for i in range(max_iter):
    z[not_escaped] = z[not_escaped]**2 + c[not_escaped]
    escaped = (np.abs(z) > threshold) & not_escaped
    escape_time[escaped] = i
    not_escaped[escaped] = False

# Plot the Mandelbrot set with moderate detail
plt.figure(figsize=(8, 8))
plt.imshow(escape_time, extent=[x_min, x_max, y_min, y_max], cmap='plasma', origin='lower')
plt.colorbar(label='Iteration Count')
plt.title('Mandelbrot Set - Intermediate Detail')
plt.axis('equal')  # Ensure proper aspect ratio
plt.savefig('mandelbrot_intermediate.png', dpi=150, bbox_inches='tight')  # Save moderate-quality image
